+    def _refresh_extra_latency(self) -> None:
+        """Re-read the latency added after the audio device, at most once a second."""
+        if self._extra_latency_path is None:
+            return
+        now = time.monotonic()
+        if now - self._extra_latency_read_at < 1.0:
+            return
+        self._extra_latency_read_at = now
+        try:
+            with open(self._extra_latency_path, encoding="ascii") as f:
+                value = max(0, int(f.read().strip()))
+        except (OSError, ValueError):
+            return  # not published (yet): keep the last value
+        if value != self._extra_output_latency_us:
+            logger.info("Output latency after the audio device: %.1f ms", value / 1000.0)
+            self._extra_output_latency_us = value
 
