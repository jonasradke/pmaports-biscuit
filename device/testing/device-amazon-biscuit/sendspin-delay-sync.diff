+    def _apply_pending_shift(
+        self, output_buffer: memoryview, bytes_written: int, frames: int
+    ) -> tuple[int, int]:
+        """Move playback by any pending shift; return (bytes_written, frames left to read).
+
+        A positive shift skips input, which advances the cursor with it; a negative
+        one plays silence without advancing the cursor, so the DAC-derived position
+        catches up with it. Either way the sync error is back near zero, and the
+        correction state starts over.
+        """
+        assert self._format is not None
+        shift_us = self._pending_shift_us
+        if shift_us:
+            self._pending_shift_us = 0
+            shift_frames = round(shift_us * self._format.sample_rate / 1_000_000)
+            if shift_frames > 0:
+                self._skip_input_frames(shift_frames)
+            elif shift_frames < 0:
+                self._pending_silence_frames += -shift_frames
+            self._sync_error_filter.reset()
+            self._sync_error_filtered_us = 0.0
+            self._insert_every_n_frames = 0
+            self._drop_every_n_frames = 0
+            logger.info("Moved playback by %.1f ms", shift_us / 1000.0)
+        if self._pending_silence_frames > 0 and frames > 0:
+            take = min(frames, self._pending_silence_frames)
+            num_bytes = take * self._format.frame_size
+            self._fill_silence(output_buffer, bytes_written, num_bytes)
+            self._pending_silence_frames -= take
+            return bytes_written + num_bytes, frames - take
+        return bytes_written, frames
+
