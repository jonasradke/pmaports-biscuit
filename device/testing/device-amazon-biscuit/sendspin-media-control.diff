+    async def _start_control(self) -> None:
+        """Listen on CONTROL_SOCKET for playback commands from this device.
+
+        A failure here must not stop the player: the button loses track
+        skipping, the speaker keeps playing.
+        """
+        loop = asyncio.get_running_loop()
+        with contextlib.suppress(FileNotFoundError):
+            os.unlink(CONTROL_SOCKET)
+        try:
+            self._control, _ = await loop.create_datagram_endpoint(
+                lambda: _ControlProtocol(self._on_control),
+                local_addr=CONTROL_SOCKET,
+                family=socket.AF_UNIX,
