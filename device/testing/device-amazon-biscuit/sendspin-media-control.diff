 logger = logging.getLogger(__name__)
 
+# Playback control from the device itself - the Echo's action button. A
+# datagram per command, root-only, because everything that sends one runs on
+# this device as root and there is nothing to answer: the result shows up as
+# Music Assistant's own state change. The daemon already holds the controller
+# role, so a command here is exactly what a Sendspin remote would send.
+CONTROL_SOCKET = "/run/sendspin-control"
+CONTROL_COMMANDS = {
+    "play": MediaCommand.PLAY,
+    "pause": MediaCommand.PAUSE,
+    "stop": MediaCommand.STOP,
+    "next": MediaCommand.NEXT,
+    "previous": MediaCommand.PREVIOUS,
+}
+
+# Music Assistant's PREVIOUS restarts the track once it is 5 s in and only
+# goes back before that - too short to hit with a button, so pressing back
+# mostly restarted the song. A PREVIOUS also sets the queue's elapsed time to
+# 0 straight away and debounces the actual playback by a second, so past 5 s
+# two in a row land exactly one track back. Under the lower bound one is sent,
+# over the upper two; in between the daemon waits until the track is surely
+# past 5 s rather than guess which side of it the server is on.
+PREVIOUS_RESTARTS_AFTER_S = (4.5, 5.5)
+PREVIOUS_GAP_S = 0.2
+
 
