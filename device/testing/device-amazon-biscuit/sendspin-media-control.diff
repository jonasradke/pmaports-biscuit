+            create_task(self._send_previous(client))
+            return
+        logger.info("Playback control: %s", word)
+        create_task(self._send_control(client, command))
+
+    async def _send_previous(self, client: SendspinClient) -> None:
+        """Go back one track, whatever the position in the current one."""
+        low, high = PREVIOUS_RESTARTS_AFTER_S
+        elapsed = self._elapsed_s()
+        if elapsed is not None and low <= elapsed < high:
+            await asyncio.sleep(high - elapsed)
+            elapsed = self._elapsed_s()
+        twice = elapsed is not None and elapsed >= high
+        logger.info("Playback control: previous at %s s%s",
+                    "?" if elapsed is None else "%.1f" % elapsed,
+                    " (restart, then back)" if twice else "")
+        await self._send_control(client, MediaCommand.PREVIOUS)
+        if twice:
+            await asyncio.sleep(PREVIOUS_GAP_S)
+            await self._send_control(client, MediaCommand.PREVIOUS)
+
+    @staticmethod
+    async def _send_control(client: SendspinClient, command: MediaCommand) -> None:
+        try:
+            await client.send_group_command(command)
+        except Exception as err:  # noqa: BLE001 - a lost command must not kill the daemon
+            logger.warning("Playback control %s failed: %s", command.value, err)
