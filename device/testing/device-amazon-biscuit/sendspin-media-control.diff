+    async def _start_control(self) -> None:
+        """Listen on CONTROL_SOCKET for playback commands from this device.
+
+        A failure here must not stop the player: the button loses track
+        skipping, the speaker keeps playing.
+        """
+        loop = asyncio.get_running_loop()
+        with contextlib.suppress(FileNotFoundError):
+            os.unlink(CONTROL_SOCKET)
+        try:
+            self._control, _ = await loop.create_datagram_endpoint(
+                lambda: _ControlProtocol(self._on_control),
+                local_addr=CONTROL_SOCKET,
+                family=socket.AF_UNIX,
+            )
+            os.chmod(CONTROL_SOCKET, 0o600)
+        except OSError as err:
+            logger.warning("No playback control socket at %s: %s", CONTROL_SOCKET, err)
+
+    def _on_control(self, word: str) -> None:
+        """Send one control-socket command to the server as a group command."""
+        if word == "toggle":
+            word = "pause" if self._playback_state == PlaybackStateType.PLAYING else "play"
+        command = CONTROL_COMMANDS.get(word)
+        if command is None:
+            logger.warning("Unknown playback control command %r", word)
+            return
+        client = self._client
+        if client is None or not client.connected:
+            logger.info("Playback control %s ignored: not connected", word)
+            return
+        logger.info("Playback control: %s", word)
+        create_task(self._send_control(client, command))
+
+    @staticmethod
+    async def _send_control(client: SendspinClient, command: MediaCommand) -> None:
+        try:
+            await client.send_group_command(command)
+        except Exception as err:  # noqa: BLE001 - a lost command must not kill the daemon
+            logger.warning("Playback control %s failed: %s", command.value, err)
