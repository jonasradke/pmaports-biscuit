+    def _on_metadata(self, payload: ServerStatePayload) -> None:
+        """Remember track progress. An absent field means unchanged."""
+        meta = payload.metadata
+        if meta is None:
+            return
+        # A new track without fresh progress leaves the old track's position
+        # behind, and extrapolating it would make previous go back two
+        # tracks. Forget it: one previous at worst restarts the new track.
+        track = dict(self._track)
+        for name in ("title", "artist", "album"):
+            value = getattr(meta, name, None)
+            if value is None or isinstance(value, str):   # else: not in this update
+                track[name] = value
+        if self._track and track != self._track:
+            self._progress = None
+        self._track = track
+        if isinstance(meta.progress, Progress):
+            p = meta.progress
+            self._progress = (p.track_progress, p.playback_speed, time.monotonic())
+        elif meta.progress is None:
+            self._progress = None
+
+    def _elapsed_s(self) -> float | None:
+        """Where the current track is now, by the server's last report."""
+        if self._progress is None:
+            return None
+        ms, speed, at = self._progress
+        return (ms + (time.monotonic() - at) * speed) / 1000
